// ──────────────────────────────────────────────
// Event Edge – Prisma Schema (Phase 1 + 2 + 3)
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id              String     @id @default(cuid())
  externalId      String     @unique
  source          String     @default("polymarket")
  title           String
  description     String     @default("")
  category        String     @default("other")
  imageUrl        String?

  yesPrice        Float
  noPrice         Float
  spread          Float
  volume24h       Float      @default(0)
  liquidity       Float      @default(0)

  resolutionDate  DateTime?
  active          Boolean    @default(true)

  dislocationScore Float     @default(0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  snapshots       Snapshot[]
  clusters        ClusterMarket[]

  @@index([category])
  @@index([dislocationScore])
  @@index([active])
}

model Snapshot {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  yesPrice    Float
  noPrice     Float
  spread      Float
  volume24h   Float
  liquidity   Float

  capturedAt  DateTime @default(now())

  @@index([marketId, capturedAt])
}

// ── Clusters (Phase 2) ──

model Cluster {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  theme       String   @default("other")

  // Phase 2 analytics
  avgProbability        Float @default(0)
  probabilityDispersion Float @default(0)
  inconsistencyScore    Float @default(0)
  divergenceScore       Float @default(0)
  confidenceScore       Float @default(0)

  // Phase 3 fields
  rankingScore    Float  @default(0)   // 0–100 composite ranking for top signals
  classification  String @default("[]") // JSON array of classification labels
  explanation     String @default("")   // human-readable summary of why flagged
  expressions     String @default("[]") // JSON array of research expressions

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  markets     ClusterMarket[]
  signals     ClusterSignal[]

  @@index([divergenceScore])
  @@index([rankingScore])
  @@index([theme])
}

model ClusterMarket {
  id        String  @id @default(cuid())
  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([clusterId, marketId])
  @@index([clusterId])
  @@index([marketId])
}

model ClusterSignal {
  id        String  @id @default(cuid())
  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  type      String
  severity  String
  message   String
  data      String  @default("{}")

  createdAt DateTime @default(now())

  @@index([clusterId, createdAt])
}
