# ============================================================
# MACRO DECISION ENGINE — Environment Configuration
# ============================================================
# Copy this to .env and fill in your API keys.
# NEVER commit .env to version control.

# Server
PORT=3001
DB_PATH=./data/decision-engine.db

# ============================================================
# DATA PROVIDERS (in priority order)
# ============================================================

# --- US Macro: FRED (Federal Reserve Economic Data) ---
# Free, 120 requests/minute
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Provides: CPI, GDP, unemployment, fed funds rate, treasury yields, yield curve
FRED_API_KEY=

# --- Market Data: Finnhub ---
# Free tier: 60 calls/minute
# Get key at: https://finnhub.io/register
# Provides: stock prices, ETF prices, FX pairs vs USD, news, calendar
FINNHUB_API_KEY=

# --- Global Macro: World Bank Data360 ---
# No API key required — public API
# Provides: GDP, inflation, trade, unemployment by country
# Base URL: https://data360api.worldbank.org

# ============================================================
# OPTIONAL PROVIDERS
# ============================================================

# Alpha Vantage — fallback prices (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=

# NewsAPI — news headlines (free tier: 100 requests/day)
NEWSAPI_API_KEY=

# ============================================================
# CACHE SETTINGS
# ============================================================
CACHE_TTL_PRICES=300
CACHE_TTL_NEWS=600
CACHE_TTL_MACRO=3600
