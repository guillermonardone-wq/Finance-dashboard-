# ============================================================
# MACRO DECISION ENGINE — Environment Configuration
# ============================================================
# Copy this to .env and fill in your API keys.
# NEVER commit .env to version control.

# Server
PORT=3002
DB_PATH=./data/decision-engine.db

# ============================================================
# DATABASE (PostgreSQL + Knex)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalforge
DB_USER=signalforge
DB_PASSWORD=dev_password

# ============================================================
# AUTHENTICATION (Session 1b)
# ============================================================
# API key for authenticating requests. Leave empty to skip auth in dev.
# API_KEY=

# Allowed CORS origin (default: Vite dev server)
# CORS_ORIGIN=http://localhost:5173

# ============================================================
# MARKET DATA PROVIDERS
# ============================================================
# At minimum, configure ONE price provider and ONE news provider.

# --- Price / Candles / Macro Series ---
# Alpha Vantage (free tier: 25 requests/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- News / Events ---
# NewsAPI (free tier: 100 requests/day, delayed)
# Get key at: https://newsapi.org/register
NEWSAPI_API_KEY=

# --- Real-time quotes + Macro calendar ---
# Finnhub (free tier: 60 calls/minute)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# ============================================================
# OPTIONAL / FUTURE PROVIDERS
# ============================================================
# These are not required for MVP but the adapter slots exist.

# Unusual Whales — options flow, dark pool, congressional trades
# Get key at: https://unusualwhales.com/api
UNUSUAL_WHALES_API_KEY=

# FRED (Federal Reserve Economic Data) — free
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Polygon.io (stocks, options, crypto)
# POLYGON_API_KEY=

# Quandl / Nasdaq Data Link
# QUANDL_API_KEY=

# IEX Cloud
# IEX_API_KEY=

# ============================================================
# PROVIDER SETTINGS
# ============================================================
# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_PRICES=300
CACHE_TTL_NEWS=600
CACHE_TTL_MACRO=3600

# Refresh interval in seconds for background jobs
REFRESH_INTERVAL_PRICES=300
REFRESH_INTERVAL_NEWS=900
REFRESH_INTERVAL_MACRO=3600
REFRESH_INTERVAL_FRED_SIGNALS=86400
REFRESH_INTERVAL_GDELT_SIGNALS=1800

# ============================================================
# SIGNAL GENERATION THRESHOLDS
# ============================================================
# FRED: multiplier for std-dev threshold (1.0 = 1 sigma)
FRED_SIGNAL_THRESHOLD_MULT=1.0

# GDELT: volume spike multiplier vs 7-day rolling average
GDELT_SPIKE_MULTIPLIER=2.0

# ============================================================
# LLM ADVISORY (Thesis Evaluation)
# ============================================================
# Anthropic Claude (default) — used for AI thesis scoring
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (optional fallback)
# OPENAI_API_KEY=

# LLM provider selection: 'anthropic' or 'openai'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
