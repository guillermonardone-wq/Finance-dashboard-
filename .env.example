# ============================================================
# MACRO DECISION ENGINE — Environment Configuration
# ============================================================
# Copy this to .env and fill in your API keys.
# NEVER commit .env to version control.

# Server
PORT=3001
DB_PATH=./data/decision-engine.db

# ============================================================
# MARKET DATA PROVIDERS
# ============================================================
# At minimum, configure ONE price provider and ONE news provider.

# --- Price / Candles / Macro Series ---
# Alpha Vantage (free tier: 25 requests/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- News / Events ---
# NewsAPI (free tier: 100 requests/day, delayed)
# Get key at: https://newsapi.org/register
NEWSAPI_API_KEY=

# --- Real-time quotes + Macro calendar ---
# Finnhub (free tier: 60 calls/minute)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# ============================================================
# OPTIONAL / FUTURE PROVIDERS
# ============================================================
# These are not required for MVP but the adapter slots exist.

# FRED (Federal Reserve Economic Data) — free
# FRED_API_KEY=

# Polygon.io (stocks, options, crypto)
# POLYGON_API_KEY=

# Quandl / Nasdaq Data Link
# QUANDL_API_KEY=

# IEX Cloud
# IEX_API_KEY=

# ============================================================
# PROVIDER SETTINGS
# ============================================================
# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_PRICES=300
CACHE_TTL_NEWS=600
CACHE_TTL_MACRO=3600

# Refresh interval in seconds for background jobs
REFRESH_INTERVAL_PRICES=300
REFRESH_INTERVAL_NEWS=900
REFRESH_INTERVAL_MACRO=3600
